{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/shop/[category]",
      "regex": "^/shop/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory"
      },
      "namedRegex": "^/shop/(?<nxtPcategory>[^/]+?)(?:/)?$"
    },
    {
      "page": "/shop/[category]/[subCategory]",
      "regex": "^/shop/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory",
        "nxtPsubCategory": "nxtPsubCategory"
      },
      "namedRegex": "^/shop/(?<nxtPcategory>[^/]+?)/(?<nxtPsubCategory>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/feedback",
      "regex": "^/admin/feedback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/feedback(?:/)?$"
    },
    {
      "page": "/admin/newsletter",
      "regex": "^/admin/newsletter(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/newsletter(?:/)?$"
    },
    {
      "page": "/api/account/profile",
      "regex": "^/api/account/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/account/profile(?:/)?$"
    },
    {
      "page": "/api/account/session",
      "regex": "^/api/account/session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/account/session(?:/)?$"
    },
    {
      "page": "/api/auth/google",
      "regex": "^/api/auth/google(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/google(?:/)?$"
    },
    {
      "page": "/api/auth/signout",
      "regex": "^/api/auth/signout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signout(?:/)?$"
    },
    {
      "page": "/api/checkout/order",
      "regex": "^/api/checkout/order(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/checkout/order(?:/)?$"
    },
    {
      "page": "/api/checkout/verify",
      "regex": "^/api/checkout/verify(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/checkout/verify(?:/)?$"
    },
    {
      "page": "/api/feedback",
      "regex": "^/api/feedback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/feedback(?:/)?$"
    },
    {
      "page": "/api/feedback/health",
      "regex": "^/api/feedback/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/feedback/health(?:/)?$"
    },
    {
      "page": "/api/newsletter",
      "regex": "^/api/newsletter(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/newsletter(?:/)?$"
    },
    {
      "page": "/api/products",
      "regex": "^/api/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/products(?:/)?$"
    },
    {
      "page": "/api/products/sub-categories",
      "regex": "^/api/products/sub\\-categories(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/products/sub\\-categories(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/shop",
      "regex": "^/shop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}