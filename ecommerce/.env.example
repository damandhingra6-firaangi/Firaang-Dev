# Instagram professional account ID and server-side Graph API token.
# Use an Instagram professional account. Media counts need instagram_basic and
# pages_read_engagement; Insights additionally needs instagram_manage_insights.
# Reel Insights request views, total_views, and reach; Facebook Login also requests
# total_views_count directly from media, which can work without Insights permission.
# view_count is omitted because Meta restricts it to Business Discovery.
# like_count and comments_count are requested as diagnostic alternatives, not displayed.
# Set INSTAGRAM_DEBUG_REEL_RESPONSE=1 to log a sanitized response sample for one Reel.
INSTAGRAM_DEBUG_REEL_RESPONSE=0
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v27.0
